# Copy this file to deploy/.env on the host. Use long random alphanumeric
# passwords so they can be safely embedded in internal connection URLs.
PROPCLUE_POSTGRES_ADMIN_PASSWORD=replace-with-random-alphanumeric-password
PROPCLUE_WORKFLOW_PASSWORD=replace-with-another-random-alphanumeric-password
PROPCLUE_SOURCE_READONLY_PASSWORD=replace-with-another-random-alphanumeric-password
PROPCLUE_MONGO_ADMIN_USER=propclue_root
PROPCLUE_MONGO_ADMIN_PASSWORD=replace-with-another-random-alphanumeric-password
PROPCLUE_MONGO_READONLY_USER=propclue_reader
PROPCLUE_MONGO_READONLY_PASSWORD=replace-with-another-random-alphanumeric-password
APP_PORT=8501
PROPCLUE_PG_HOST_PORT=55432
PROPCLUE_MONGO_HOST_PORT=27018
